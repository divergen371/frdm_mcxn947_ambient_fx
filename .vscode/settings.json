{
  "cmake.configureOnOpen": false,
  "cmake.useCMakePresets": "always",
  "cmake.buildTask": true,
  "cmake.skipConfigureIfCachePresent": true,
  "cmake.sourceDirectory": "${workspaceFolder}",

  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.enhancedColorization": "disabled",
  "C_Cpp.codeAnalysis.clangTidy.enabled": false,
  "C_Cpp.inlayHints.autoDeclarationTypes.enabled": false,
  "C_Cpp.inlayHints.parameterNames.enabled": false,
  "C_Cpp.formatting": "disabled",
  "C_Cpp.dimInactiveRegions": false,
  "C_Cpp.configurationWarnings": "disabled",
  "C_Cpp.suggestSnippets": false,
  "C_Cpp.files.exclude": {
    "**/.vscode": true,
    "**/__repo__": true
  },
  "C_Cpp.exclusionPolicy": "checkFolders",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "c-cpp-flylint.enable": false,

  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },

  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/release",
    "--query-driver=/Users/atsushi/.mcuxpressotools/arm-gnu-toolchain-*/bin/arm-none-eabi-*",
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=never",
    "--pch-storage=memory",
    "-j=4"
  ],
  "clangd.onConfigChanged": "restart",

  "mcuxpresso.linkserver.path": "/Applications/LinkServer_26.9.130/LinkServer",
  "mcuxpresso.debug.defaultDebugInterface": "SWD",
  "mcuxpresso.debug.registerUseNaturalFormat": true,
  "mcuxpresso.debug.variableUseNaturalFormat": true,

  "files.watcherExclude": {
    "**/build/**": true,
    "**/debug/**": true,
    "**/release/**": true,
    "**/.cache/**": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/debug/**": true,
    "**/release/**": true,
    "**/.cache/**": true,
    "**/.specstory/**": true
  },
  "specstory.cloudSync.enabled": "never"
}
